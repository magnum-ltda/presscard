rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Leitura pública para exibir o catálogo na landing page
    // Escrita restrita apenas para usuários autenticados
    match /benefits/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /partners/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 🔒 Dados sensíveis — leitura e escrita exigem autenticação
    match /employees/{document} {
      allow read, write: if request.auth != null;
    }

    match /companies/{document} {
      allow read, write: if request.auth != null;
    }

    match /coupons/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
